{
  "image_size": 640,
  "roi_size": 224,
  "classes": [
    "glioma",
    "meningioma",
    "pituitary",
    "no_tumor"
  ],
  "num_classes": 4,
  "num_workers": 12,
  "pin_memory": true,
  "seed": 42,
  "device": "cuda",
  "dataset_path": "./dataset/",
  "roi_dataset_path": "./roi_dataset/",
  "weights_dir": "./weights/",
  "results_dir": "./results/",
  "yolo_model": "yolo11n-cbam.yaml",
  "yolo_weights": "./weights/tumor_locator.pt",
  "yolo_epochs": 150,
  "yolo_patience": 30,
  "yolo_conf_thresh": 0.45,
  "yolo_iou_thresh": 0.5,
  "yolo_metric": "mAP_0.5:0.95",
  "use_cbam": true,
  "cbam_min_layer_index": 10,
  "roi_padding": 0.1,
  "force_rebuild_roi": true,
  "classifiers": [
    "resnet50",
    "mobilenet_v2",
    "efficientnet_b0"
  ],
  "batch_size": 32,
  "learning_rate": 0.0005,
  "learning_rate_ft": 8e-06,
  "head_epochs": 15,
  "finetune_epochs": 45,
  "classifier_early_stopping_patience": 7,
  "classifier_early_stopping_min_delta": 0.0001,
  "dropout_rate": 0.4,
  "use_pretrained": true,
  "classifier_weights": {
    "resnet50": "weights/resnet50.pth",
    "mobilenet_v2": "weights/mobilenet_v2.pth",
    "efficientnet_b0": "weights/efficientnet_b0.pth"
  },
  "use_class_weights": true,
  "load_yolo_data": true,
  "train_yolo": true,
  "build_roi_dataset": true,
  "train_classifiers": true,
  "run_pipeline_on_test": true,
  "run_results_manager": true,
  "no_tumor_fallback": true,
  "run_optuna": true,
  "optuna_trials": 10,
  "run_gradcam": true
}