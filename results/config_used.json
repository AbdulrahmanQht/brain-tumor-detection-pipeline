{
  "image_size": 640,
  "roi_size": 224,
  "classes": [
    "glioma",
    "meningioma",
    "pituitary",
    "no_tumor"
  ],
  "num_classes": 4,
  "num_workers": 2,
  "pin_memory": true,
  "seed": 42,
  "device": "cuda",
  "dataset_path": "./dataset/",
  "roi_dataset_path": "./roi_dataset/",
  "weights_dir": "./weights/",
  "results_dir": "./results/",
  "yolo_model": "yolo11n.pt",
  "yolo_weights": "weights\\tumor_locator.pt",
  "yolo_epochs": 1,
  "yolo_patience": 10,
  "yolo_conf_thresh": 0.5322246404246138,
  "yolo_iou_thresh": 0.5,
  "yolo_metric": "mAP_0.5:0.95",
  "use_cbam": true,
  "cbam_min_layer_index": 10,
  "roi_padding": 0.1,
  "force_rebuild_roi": false,
  "classifiers": [
    "resnet50",
    "mobilenet_v2",
    "efficientnet_b0"
  ],
  "batch_size": 32,
  "learning_rate": 3.302110120785252e-05,
  "learning_rate_ft": 1e-05,
  "head_epochs": 1,
  "finetune_epochs": 1,
  "dropout_rate": 0.4204299141029013,
  "use_pretrained": true,
  "classifier_weights": {
    "resnet50": "weights\\resnet50.pth",
    "mobilenet_v2": "weights\\mobilenet_v2.pth",
    "efficientnet_b0": "weights\\efficientnet_b0.pth"
  },
  "use_class_weights": true,
  "load_yolo_data": true,
  "train_yolo": true,
  "build_roi_dataset": true,
  "train_classifiers": true,
  "run_pipeline_on_test": true,
  "run_results_manager": true,
  "no_tumor_fallback": true,
  "run_optuna": true,
  "optuna_trials": 1,
  "run_gradcam": true
}